#include <iostream>

int main() {
    int rows = 5;

    std::cout << "1. Pyramid (*)\n\n";
    for (int i = 1; i <= rows; ++i) {
        // Print leading spaces
        for (int j = 0; j < rows - i; ++j) {
            std::cout << " ";
        }
        // Print stars
        for (int k = 0; k < (2 * i - 1); ++k) {
            std::cout << "*";
        }
        std::cout << "\n"; // Move to the next line
    }

    std::cout << "\n------------------\n\n";

    std::cout << "2. Number Triangle\n\n";
    for (int i = 1; i <= rows; ++i) {
        // Print numbers up to the current row number
        for (int j = 1; j <= i; ++j) {
            std::cout << j << " ";
        }
        std::cout << "\n";
    }

    std::cout << "\n------------------\n\n";

    std::cout << "3. Diamond Shape\n\n";
    // Upper half of the diamond
    for (int i = 1; i <= rows; ++i) {
        for (int j = 0; j < rows - i; ++j) {
            std::cout << " ";
        }
        for (int k = 0; k < (2 * i - 1); ++k) {
            std::cout << "*";
        }
        std::cout << "\n";
    }
    
    // Lower half of the diamond (reverse of the upper half)
    for (int i = rows - 1; i >= 1; --i) {
        for (int j = 0; j < rows - i; ++j) {
            std::cout << " ";
        }
        for (int k = 0; k < (2 * i - 1); ++k) {
            std::cout << "*";
        }
        std::cout << "\n";
    }

    return 0;
}
